{
  "manifest_version": 3,
  "name": "Color Season Shopper",
  "version": "0.1.0",
  "description": "Match product colors to your seasonal color palette",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["color-analysis.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["palettes.json"],
      "matches": ["https://*/*"]
    }
  ]
}
